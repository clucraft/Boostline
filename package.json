{
  "name": "boostline",
  "productName": "Boostline",
  "version": "0.5.0",
  "description": "ECU data logger, log viewer, road dyno and drag timer for BMW B38/B48/B58/S58/N63/S63 engines",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --universal --publish never"
  },
  "build": {
    "appId": "app.boostline.logger",
    "productName": "Boostline",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Boostline-${version}-mac-universal.${ext}"
    },
    "dmg": {
      "title": "Boostline ${version}"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
