{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@core/*": ["src/core/*"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  },
  "include": ["src/mobile/**/*", "src/renderer/src/**/*", "src/core/**/*", "src/shared/**/*", "src/preload/*.d.ts", "vite.mobile.config.ts", "capacitor.config.ts", "test/mobileRuntime.test.ts", "test/fakeGateway.ts", "src/main/nodeRuntime.ts"]
}
